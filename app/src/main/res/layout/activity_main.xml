<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/nxBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="?attr/nxText"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                        android:textIsSelectable="false"
                        android:longClickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/loading"
                    android:textColor="?attr/nxTextDim"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_lang"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="EN"
                android:textColor="?attr/nxText"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/nx_card" />

            <TextView
                android:id="@+id/btn_theme"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="◐"
                android:textColor="?attr/nxPrimary"
                android:textSize="17sp"
                android:background="@drawable/nx_card" />

            <TextView
                android:id="@+id/btn_refresh"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="⟳"
                android:textColor="?attr/nxText"
                android:textSize="17sp"
                android:background="@drawable/nx_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="@drawable/nx_card">

            <TextView
                android:id="@+id/tab_board"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_board"
                android:textColor="?attr/nxOnPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/nx_pill_on" />

            <TextView
                android:id="@+id/tab_train"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_train"
                android:textColor="?attr/nxTextDim"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/nx_pill_off" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/chips_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="18dp"
                    android:scrollbars="none" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <LinearLayout
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/nx_card"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_title"
                    android:textColor="?attr/nxText"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/empty_body"
                    android:textColor="?attr/nxTextDim"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/empty_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingStart="16dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="9dp"
                    android:background="@drawable/nx_pill_on"
                    android:text="@string/connect"
                    android:textColor="?attr/nxOnPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/train_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:background="@drawable/nx_card">

                        <TextView
                            android:id="@+id/tr_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loading"
                            android:textColor="?attr/nxPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tr_run"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="—"
                            android:textColor="?attr/nxText"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tr_stage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            android:textColor="?attr/nxTextDim"
                            android:textSize="13sp" />

                        <ProgressBar
                            android:id="@+id/tr_bar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="16dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/nx_bar" />

                        <TextView
                            android:id="@+id/tr_step"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="—"
                            android:textColor="?attr/nxText"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:background="@drawable/nx_card">

                            <TextView style="@style/NxMetricLabel" android:text="@string/train_loss" />
                            <TextView android:id="@+id/tr_loss" style="@style/NxMetricValue" android:text="—" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:background="@drawable/nx_card">

                            <TextView style="@style/NxMetricLabel" android:text="@string/train_eta" />
                            <TextView android:id="@+id/tr_eta" style="@style/NxMetricValue" android:text="—" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:background="@drawable/nx_card">

                            <TextView style="@style/NxMetricLabel" android:text="@string/train_rate" />
                            <TextView android:id="@+id/tr_rate" style="@style/NxMetricValue" android:text="—" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:background="@drawable/nx_card">

                            <TextView style="@style/NxMetricLabel" android:text="@string/train_step" />
                            <TextView android:id="@+id/tr_steps" style="@style/NxMetricValue" android:text="—" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/nx_card">

                        <TextView style="@style/NxMetricLabel" android:text="@string/loss_chart" />
                        <ru.nexus.board.SparkView
                            android:id="@+id/tr_spark"
                            android:layout_width="match_parent"
                            android:layout_height="86dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/nx_card">

                        <TextView style="@style/NxMetricLabel" android:text="@string/train_phase" />
                        <TextView
                            android:id="@+id/tr_chain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="—"
                            android:textColor="?attr/nxTextDim"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/nx_card">

                        <TextView style="@style/NxMetricLabel" android:text="@string/train_log" />
                        <TextView
                            android:id="@+id/tr_tail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:text="—"
                            android:textColor="?attr/nxTextDim"
                            android:textSize="11.5sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
