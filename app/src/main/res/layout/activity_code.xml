<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/nxBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/code_back"
                android:layout_width="40dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="@string/chat_back_glyph"
                android:textColor="?attr/nxText"
                android:textSize="20sp"
                android:background="@drawable/nx_card"
                android:contentDescription="@string/chat_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/code_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/code_title"
                    android:textColor="?attr/nxText"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/code_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/nxTextDim"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/code_pull"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/code_pull"
                android:textColor="?attr/nxText"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/nx_card" />

            <TextView
                android:id="@+id/code_save"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/code_save"
                android:textColor="?attr/nxOnPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/nx_pill_on" />
        </LinearLayout>

        <EditText
            android:id="@+id/code_editor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:background="@drawable/nx_editor"
            android:padding="14dp"
            android:gravity="top|start"
            android:fontFamily="monospace"
            android:textSize="12.5sp"
            android:textColor="?attr/nxText"
            android:textColorHint="?attr/nxTextDim"
            android:hint="@string/code_hint"
            android:lineSpacingExtra="2dp"
            android:inputType="textMultiLine|textNoSuggestions|textVisiblePassword"
            android:imeOptions="flagNoExtractUi"
            android:scrollbars="vertical"
            android:importantForAutofill="no"
            android:textIsSelectable="true" />
    </LinearLayout>
</FrameLayout>
